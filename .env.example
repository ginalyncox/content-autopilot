# Required to use the app at all
ADMIN_PASSWORD=

# Drafting (optional: without it, drafts are editable templates)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Website publishing: a GitHub token with Contents write access to the two repos
GITHUB_TOKEN=
GINAMAKES_REPO=ginalyncox/gina-makes-bread-dev
GINAMAKES_PATH=content/autopilot/{date}-{slug}.md
GINAMAKES_URL=
HEARTHVALE_REPO=ginalyncox/ginalyncox
HEARTHVALE_PATH=hearthvale/news/{date}-{slug}.md
HEARTHVALE_URL=

# Email (Resend). Sending is refused until MAILING_ADDRESS has a street or PO Box and ZIP.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
EMAIL_FROM="Gina Makes <hello@ginamakesbread.dev>"
EMAIL_REPLY_TO=
MAILING_ADDRESS=

# Where items are saved until the Notion store is added
DATA_FILE=data/items.json
